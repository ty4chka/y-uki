// scan.ykn — first-pass heuristic scan of package contents for malicious patterns.
// Before root writes files into the system, walk the unpacked tree
// and look for what "looks bad": reverse shells, miners,
// persistence, hidden payloads, setuid, log wiping.
// This is NOT an antivirus: no signatures, only heuristics with severity levels.
//   yuki scan <dir>            scan any unpacked folder
//   (install shows the summary itself, before writing to the system)
// The result is a "what looks bad" summary with advice to reconsider;
// high findings block the install unless YUKI_ALLOW_RISKY=1 opts out deliberately.

load core.panic: panic
load std.io: println
load std.fs.files: file_read_text, file_metadata
load std.fs.dirs: dir_list, dir_exists
load std.fs.paths: path_file_name
load std.strings: eq, contains
load .errors: err
load .ui: ok, info, warn, card, c_accent, c_bad, c_dim, c_warn, c_bold
load .theme: sym
load .util: str_starts, join2, str_lower, str_pad_end, int_str

public struct ScanHit {
    sev: string      // "high" | "med" | "low"
    file: string     // path inside the package
    why: string      // what exactly looks bad
}

static MAX_HITS: int64 = 40
static MAX_FILES: int64 = 1500
static MAX_BYTES: int64 = 262144   // text files larger than 256 KiB are not read

fun add_hit(ref hits: ScanHit[], ref ~n: int64, sev: string, file: string, why: string) {
    if n >= MAX_HITS {
        return
    }
    hits.push(ScanHit { sev: sev, file: file, why: why })
    rewrite n += 1
}

// One heuristic = one if. Patterns are matched against lowercased file content.
fun look(t: string, file: string, ref hits: ScanHit[], ref ~n: int64) {
    // download and run at once
    set dl = contains(t, "curl") || contains(t, "wget")
    set piped = contains(t, "| sh") || contains(t, "|sh ") || contains(t, "| bash") || contains(t, "|bash")
    if dl && piped {
        add_hit(ref hits, ref ~n, "high", file, "pipes a downloaded script straight into a shell")
    }
    // reverse shells
    if contains(t, "/dev/tcp/") {
        add_hit(ref hits, ref ~n, "high", file, "opens a raw reverse shell over /dev/tcp")
    }
    if contains(t, "bash -i >&") {
        add_hit(ref hits, ref ~n, "high", file, "relays an interactive bash over the network")
    }
    if contains(t, "nc -e ") || contains(t, "ncat -e ") {
        add_hit(ref hits, ref ~n, "high", file, "hands a shell to the network with netcat -e")
    }
    // persistence and access
    if contains(t, "authorized_keys") {
        add_hit(ref hits, ref ~n, "high", file, "touches ssh authorized_keys (backdoor access)")
    }
    if contains(t, "ld.so.preload") {
        add_hit(ref hits, ref ~n, "high", file, "installs an ld.so.preload hook (rootkit trick)")
    }
    if contains(t, "systemctl enable") {
        add_hit(ref hits, ref ~n, "med", file, "installs a systemd service (persistence)")
    }
    if contains(t, "/etc/cron") || contains(t, "crontab ") {
        add_hit(ref hits, ref ~n, "med", file, "installs a cron job (persistence)")
    }
    // destruction and secrets
    if contains(t, "rm -rf /") {
        add_hit(ref hits, ref ~n, "high", file, "destructive `rm -rf /`")
    }
    if contains(t, "/etc/shadow") {
        add_hit(ref hits, ref ~n, "high", file, "reads /etc/shadow password hashes")
    }
    // miners
    set mine = contains(t, "stratum+tcp") || contains(t, "stratum+ssl") || contains(t, "cryptonight") || contains(t, "xmrig") || contains(t, "minerd")
    if mine {
        add_hit(ref hits, ref ~n, "high", file, "cryptocurrency miner strings")
    }
    // hidden payloads
    set b64 = contains(t, "base64 -d") || contains(t, "base64 --decode") || contains(t, "openssl enc -d")
    if b64 {
        add_hit(ref hits, ref ~n, "med", file, "decodes a hidden payload (base64/openssl)")
    }
    if contains(t, "eval") && contains(t, "base64") {
        add_hit(ref hits, ref ~n, "high", file, "eval of base64-decoded text (obfuscated code)")
    }
    // privileges and modules
    if contains(t, "chmod u+s") || contains(t, "chmod +s") || contains(t, "chmod 4755") || contains(t, "chmod 6755") {
        add_hit(ref hits, ref ~n, "med", file, "sets setuid bits")
    }
    if contains(t, "insmod ") || contains(t, "modprobe ") {
        add_hit(ref hits, ref ~n, "med", file, "loads kernel modules")
    }
    // covering tracks
    if contains(t, "history -c") || contains(t, "shred -") || contains(t, "wevtutil") {
        add_hit(ref hits, ref ~n, "med", file, "clears logs / covers tracks")
    }
    if contains(t, "pastebin.com") {
        add_hit(ref hits, ref ~n, "med", file, "pulls content from a paste service")
    }
    // minor findings
    if contains(t, "telemetry") || contains(t, "phone home") {
        add_hit(ref hits, ref ~n, "low", file, "mentions telemetry / phoning home")
    }
    if contains(t, "icanhazip") || contains(t, "ifconfig.me") || contains(t, "checkip.amazonaws") {
        add_hit(ref hits, ref ~n, "low", file, "checks your public ip")
    }
}

// Recursive tree walk with a budget: depth <= 8, at most MAX_FILES;
// docs/man skipped, large and binary files are not read.
fun scan_tree(base: string, sub: string, depth: int64, ref hits: ScanHit[], ref ~n: int64, ref ~files: int64) {
    if depth > 8 || files >= MAX_FILES {
        return
    }
    set dir = base
    if sub.len() > 0 {
        rewrite dir = join2(base, sub)
    }
    set ls: string[] = []
    set okd = false
    sus {
        rewrite ls = dir_list(dir)
        rewrite okd = true
    } catch {
        space
    }
    if !okd {
        return
    }
    for i in 0..ls.len() {
        if n >= MAX_HITS || files >= MAX_FILES {
            return
        }
        set name = path_file_name(ls[i])
        if eq(name, ".") || eq(name, "..") || eq(name, ".git") {
            continue
        }
        set rel = name
        if sub.len() > 0 {
            rewrite rel = sub + "/" + name
        }
        if str_starts(rel, "share/doc") || str_starts(rel, "share/man") || str_starts(rel, "share/licenses") {
            continue
        }
        set full = join2(base, rel)
        set md = file_metadata(full)
        if md.is_symlink {
            continue
        }
        set isdir = false
        set probe: string[] = []
        sus {
            rewrite probe = dir_list(full)
            rewrite isdir = true
        } catch {
            space
        }
        if isdir {
            scan_tree(base, rel, depth + 1, ref hits, ref ~n, ref ~files)
            continue
        }
        rewrite files += 1
        if md.size > MAX_BYTES {
            continue
        }
        set text = ""
        set okf = false
        sus {
            rewrite text = file_read_text(full)
            rewrite okf = true
        } catch {
            space
        }
        if !okf || text.len() == 0 {
            continue
        }
        look(str_lower(text), rel, ref hits, ref ~n)
    }
}

// Scans an unpacked tree; returns the findings (possibly empty).
public fun scan_dir(root: string) -> ScanHit[] {
    set hits: ScanHit[] = []
    set n: int64 = 0
    set files: int64 = 0
    scan_tree(root, "", 0, ref hits, ref ~n, ref ~files)
    return hits
}

// "What looks bad" summary: a findings card with advice to reconsider.
// Returns the worst level: 0 clean, 1 minor, 2 medium, 3 high.
public fun print_report(pkg: string, ref hits: ScanHit[]) -> int64 {
    set rows: string[] = []
    set nhigh: int64 = 0
    set nmed: int64 = 0
    set nlow: int64 = 0
    for i in 0..hits.len() {
        set tag = c_dim(str_pad_end("low", 5))
        if eq(hits[i].sev, "high") {
            rewrite tag = c_bad(str_pad_end("HIGH", 5))
            rewrite nhigh += 1
        } elif eq(hits[i].sev, "med") {
            rewrite tag = c_warn(str_pad_end("med", 5))
            rewrite nmed += 1
        } else {
            rewrite nlow += 1
        }
        rows.push(tag + " " + c_accent(hits[i].file) + "  " + c_dim(hits[i].why))
    }
    println("")
    println("  " + c_accent("::") + " " + c_bold(pkg) + " " + c_dim("content scan"))
    card(ref rows)
    println("  " + c_dim("findings: " + int_str(nhigh) + " high " + sym("dot") + " " + int_str(nmed) + " med " + sym("dot") + " " + int_str(nlow) + " low"))
    set worst: int64 = 0
    for i in 0..hits.len() {
        if eq(hits[i].sev, "high") {
            rewrite worst = 3
        } elif eq(hits[i].sev, "med") && worst < 2 {
            rewrite worst = 2
        } elif eq(hits[i].sev, "low") && worst == 0 {
            rewrite worst = 1
        }
    }
    if worst == 3 {
        println("  " + c_bad(sym("fail") + " HIGH-risk patterns in " + pkg + " — re-check the upstream (homepage, sources) before trusting it"))
    } elif worst == 2 {
        warn("some patterns in " + pkg + " deserve a second look (see above) — better re-check the solution")
    } else {
        info("only minor notes in " + pkg)
    }
    return worst
}

// yuki scan <dir>: scan any unpacked folder by hand.
public fun cmd_scan(path: string) {
    if !dir_exists(path) {
        panic(err("not a directory: " + path, 759, path))
    }
    set hits = scan_dir(path)
    if hits.len() == 0 {
        ok("nothing suspicious found in " + c_accent(path))
        return
    }
    set s = print_report(path, ref hits)
    if s >= 3 {
        panic(err("high-risk patterns found: review the report above", 759, path))
    }
}
