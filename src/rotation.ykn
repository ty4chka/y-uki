// rotation.ykn — registry key rotation and revocation.
//
// <index>/keys/rotation.json  { "seq": 7, "expires": 1798761600,
//                               "add": [{"name": "main2", "key": "<64 hex>"}],
//                               "revoke": ["<64 hex>"] }
// <index>/keys/rotation.sigs  lines "<pubkey hex> <signature hex>"
//
// Applied only when at least threshold DIFFERENT trusted keys with the
// "publisher" role signed it. A "renewer" key cannot rotate keys.

load core.panic: panic
load std.json: json_parse
load std.hash: blake3_str
load std.fs.files: file_read_text
load std.strings: trim, eq
load .errors: YukiError, err
load .stage: stage_create, run_child, stage_remove
load .view: InstallView
load .trust: trusted_keys, trusted_roles, threshold, revoke_key, trust_add, fingerprint
load .verify: verify_text
load .index: seen_get, seen_set, seen_hash
load .util: now_secs, is_hex, valid_name, join2, str_lines, str_lower, str_split, int_str
load .priv: is_root
load .ui: ok, info, warn, step, c_accent, c_dim

fun rot_in_list(ref l: string[], x: string) -> bool {
    for i in 0..l.len() {
        if eq(l[i], x) {
            return true
        }
    }
    return false
}

fun is_trusted_publisher(ref keys: string[], ref roles: string[], pubkey_hex: string) -> bool {
    for i in 0..keys.len() {
        if eq(keys[i], pubkey_hex) && i < roles.len() && eq(roles[i], "publisher") {
            return true
        }
    }
    return false
}

// Fetches the signed key rotation file (unprivileged), verifies the publisher
// threshold and applies the added and revoked keys as root. Panics with
// YukiError (750/760/761/762/763) on any violation or failure.
public fun cmd_keys_refresh() {
    if !is_root() {
        panic(err("changing trusted keys needs root: run `sudo yuki keys refresh`", 750, ""))
    }
    step(1, 3, "fetching the key rotation file (unprivileged)")
    set stage = stage_create()
    sus {
        set quiet = init InstallView("", false)
        set nomap: int64[] = []
        run_child(stage, "keys", ref ~quiet, ref nomap)
        set text = file_read_text(join2(join2(stage, "dl"), "rotation.json"))
        set sigs = str_lines(file_read_text(join2(join2(stage, "dl"), "rotation.sigs")))

        step(2, 3, "checking signatures as root")
        set keys = trusted_keys()
        set roles = trusted_roles()
        set counted: string[] = []
        for i in 0..sigs.len() {
            set p = str_split(trim(sigs[i]), " ")
            if p.len() == 2 {
                set k = str_lower(p[0])
                if is_trusted_publisher(ref keys, ref roles, k) && !rot_in_list(ref counted, k) {
                    if verify_text(k, text, p[1]) {
                        counted.push(k)
                    }
                }
            }
        }
        set need = threshold()
        if counted.len() < need {
            panic(err("rotation is signed by " + int_str(counted.len()) + " trusted publisher key(s), " + int_str(need) + " required", 760, "rotation.json"))
        }

        set doc = json_parse(text)
        set seq = doc.get("seq").as_int()
        if doc.get("expires").as_int() < now_secs() {
            panic(err("rotation file has expired", 761, "rotation.json"))
        }
        // Anti-rollback, seq vs the recorded state:
        //   seq < seen  -> panic
        //   seq == seen -> accept if the stored hash matches, else panic; a
        //                  record without a hash is accepted and backfilled
        //   seq > seen  -> accept and record
        set content_hash = blake3_str(text)
        set prev = seen_get("__rotation__")
        set stored_hash = seen_hash("__rotation__")
        if seq < prev {
            panic(err("rotation file is older than one already applied", 762, "rotation.json"))
        }
        if seq == prev && stored_hash.len() > 0 && !eq(content_hash, stored_hash) {
            panic(err("rotation file changed at the same seq (rollback attack?)", 762, "rotation.json"))
        }

        step(3, 3, "applying")
        set add = doc.get("add")
        for i in 0..add.len() {
            set nm = add.at(i).get("name").as_string_or("")
            set key = str_lower(add.at(i).get("key").as_string_or(""))
            if valid_name(nm) && key.len() == 64 && is_hex(key) {
                sus {
                    trust_add(nm, key, add.at(i).get("role").as_string_or("publisher"), true)
                    ok("trusted new key " + c_accent(nm) + " " + c_dim(fingerprint(key)))
                } catch {
                    info("key " + nm + " is already known or revoked, skipped")
                }
            }
        }
        set rev = doc.get("revoke")
        for i in 0..rev.len() {
            set key = str_lower(rev.at(i).as_string_or(""))
            if key.len() == 64 && is_hex(key) {
                revoke_key(key)
                warn("revoked key " + c_dim(fingerprint(key)))
            }
        }
        seen_set("__rotation__", seq, content_hash)
    } catch e: YukiError {
        stage_remove(stage)
        panic(e)
    } catch {
        stage_remove(stage)
        panic(err("key refresh failed: " + errkind, 763, ""))
    }
    stage_remove(stage)
    ok("keys are up to date")
}
