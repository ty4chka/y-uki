fun find(k: string) -> int64 {
    for i in 0..I18N_KEYS.len() {
        if eq(I18N_KEYS[i], k) {
            return i
        }
    }
    return -1
}

// Fallback for call sites that pass literal English text instead of a key
// (row() descriptions, help_lines() descriptions and flag lines): finds the
// table row whose English column matches, so t() can pick the RU column.
fun find_en(v: string) -> int64 {
    for i in 0..I18N_EN.len() {
        if eq(I18N_EN[i], v) {
            return i
        }
    }
    return -1
}

// Substitutes {0}, {1}, ... with values from args. replace() returns an empty string
// for an empty result, so only non-empty results are applied and re-copied.
fun subst(s_in: string, args: string[]) -> string {
    set out: string = s_in + ""
    for i in 0..args.len() {
        set ph = "{" + int_str(i) + "}"
        set r = replace(out, ph, args[i])
        if r.len() > 0 {
            rewrite out = r + ""
        }
    }
    return out
}

public fun t(key: string, args: string[] = []) -> string {
    set i = find(key)
    if i < 0 {
        rewrite i = find_en(key)
    }
    if i < 0 {
        return key
    }
    set s = I18N_EN[i]
    if eq(lang(), "ru") {
        rewrite s = I18N_RU[i]
    }
    return subst(s, args)
}

// ru_RU.UTF-8 and other ru* -> "ru"; en* -> "en"; otherwise empty.
fun lang_from_locale(v: string) -> string {
    set l = str_lower(v)
    if str_starts(l, "ru") {
        return "ru"
    }
    if str_starts(l, "en") {
        return "en"
    }
    return ""
}

fun lang_normalize(v: string) -> string {
    return lang_from_locale(v)
}

// Precedence: YUKI_LANG_CACHE -> YUKI_LANG -> LANG -> LC_ALL -> "en".
public fun lang() -> string {
    if has_env("YUKI_LANG_CACHE") {
        set c = lang_normalize(get_or("YUKI_LANG_CACHE", ""))
        if c.len() > 0 {
            return c
        }
    }
    set a = lang_normalize(get_or("YUKI_LANG", ""))
    if a.len() > 0 {
        return a
    }
    set b = lang_normalize(get_or("LANG", ""))
    if b.len() > 0 {
        return b
    }
    set d = lang_normalize(get_or("LC_ALL", ""))
    if d.len() > 0 {
        return d
    }
    return "en"
}

// An empty or invalid value enables auto-detection, never crashes.
public fun i18n_init(v: string) {
    set n = lang_normalize(v)
    if n.len() == 0 {
        rewrite n = lang()
    }
    set_env("YUKI_LANG_CACHE", n)
}
