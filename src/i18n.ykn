// i18n.ykn — minimal localization: an EN/RU key table with argument substitution.
// The table lives in three parallel arrays: a module-level static HashMap does not
// work in this compiler. An unknown key is returned as-is, never panics.
// Numeric arguments are passed as strings only: the caller must call int_str().

load std.strings: eq, replace
load std.env: get_or, set_env, has_env
load .util: str_lower, str_starts, int_str

