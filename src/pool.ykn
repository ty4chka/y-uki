// pool.ykn — parallel downloads.
// Thread pool (std.threads). No data is shared between threads: each task has its own
// mailbox directory <dir>/ with files
//   job-<i>     "kind<TAB>url<TAB>checksum<TAB>dest<TAB>label"
//   prog-<i>    "bytes received so far"  (written by the worker)
//   state-<i>   "ok\n<result>" or "err\n<code>\n<message>"  (written by the worker)
// One thread (the main one) paints and polls; workers download and verify the hash right away,
// so the animation does not stall while blake3 is computed.

load core.utils: cast
load core.panic: panic
load std.threads: spawn, join, is_finished, sleep, hardware_concurrency
load std.env: get_or, set_env
load std.fs.files: file_exists, file_read_text, file_write_text
load std.fs.dirs: dir_create_all
load std.fs.paths: path_parent

load std.strings: parse_int, eq
load .errors: YukiError, err
load .config: MAX_DOWNLOAD
load .fetch: download
load .pipeline: fetch_verified
load .verify: VerifyError, check_blake3
load .util: now_ms, join2, str_split, int_str, fmt_speed

fun p_job(dir: string, i: int64) -> string {
    return join2(dir, "job-" + int_str(i))
}

fun p_prog(dir: string, i: int64) -> string {
    return join2(dir, "prog-" + int_str(i))
}

fun p_state(dir: string, i: int64) -> string {
    return join2(dir, "state-" + int_str(i))
}

public fun pool_prepare(dir: string) {
    dir_create_all(dir)
}

// kind: "cache" | "file"
public fun pool_add(dir: string, i: int64, kind: string, url: string, checksum: string, dest: string, label: string) {
    file_write_text(p_job(dir, i), kind + "\t" + url + "\t" + checksum + "\t" + dest + "\t" + label)
}

fun run_job(dir: string, i: int64) {
    set parts = str_split(file_read_text(p_job(dir, i)), "\t")
    set kind = parts[0]
    set url = parts[1]
    set checksum = parts[2]
    set dest = parts[3]
    set label = parts[4]
    set prog = p_prog(dir, i)
    if eq(kind, "cache") {
        set got = fetch_verified(url, checksum, label, prog)
        file_write_text(p_state(dir, i), "ok\n" + got.path + "\t" + int_str(got.bytes))
    } else {
        dir_create_all(path_parent(dest))
        set size = download(url, dest, MAX_DOWNLOAD, prog)
        check_blake3(dest, checksum)
        file_write_text(p_state(dir, i), "ok\n" + dest + "\t" + int_str(size))
    }
}

// Thread entry point. arg = task number + 1 (0 would be null).
#[thunk]
fun pool_worker(arg: ptr<void>) {
    set i: int64 = cast(arg, "int64") - 1
    set dir = get_or("YUKI_POOL_DIR", "")
    sus {
        run_job(dir, i)
    } catch e: YukiError {
        file_write_text(p_state(dir, i), "err\n" + int_str(cast(e.code, "int64")) + "\n" + e.message)
    } catch e: VerifyError {
        file_write_text(p_state(dir, i), "err\n" + int_str(cast(300 + e.code, "int64")) + "\n" + e.message)
    } catch {
        file_write_text(p_state(dir, i), "err\n755\nworker failed: " + errkind)
    }
}

public fun jobs_limit() -> int64 {
    set env: int64 = cast(parse_int(get_or("YUKI_JOBS", "")) ?? 0, "int64")
    if env >= 1 && env <= 16 {
        return env
    }
    set cores: int64 = cast(hardware_concurrency(), "int64")
    if cores < 2 {
        return 2
    }
    if cores > 4 {
        return 4
    }
    return cores
}

fun read_received(dir: string, i: int64) -> int64 {
    set f = p_prog(dir, i)
    if !file_exists(f) {
        return 0
    }
    set n: int64 = 0
    sus {
        set parts = str_split(file_read_text(f), " ")
        rewrite n = parse_int(parts[0]) ?? 0
    } catch {
        rewrite n = 0
    }
    return n
}

fun read_total(dir: string, i: int64) -> int64 {
    set f = p_prog(dir, i)
    if !file_exists(f) {
        return 0
    }
    set n: int64 = 0
    sus {
        set parts = str_split(file_read_text(f), " ")
        if parts.len() > 1 {
            rewrite n = parse_int(parts[1]) ?? 0
        }
    } catch {
        rewrite n = 0
    }
    return n
}

// Refreshes the panel from the progress files. nidx[i] = panel node for task i (or -1).
public fun pool_paint(dir: string, count: int64, ref nidx: int64[], t0: int64, ref ~view: InstallView) {
    set sum: int64 = 0
    for i in 0..count {
        set got = read_received(dir, i)
        rewrite sum += got
        if nidx[i] >= 0 {
            set total = read_total(dir, i)
            if total > 0 {
                view.set_pct(nidx[i], got * 100 / total)
            }
        }
    }
    set el = now_ms() - t0
    if el > 0 && sum > 0 {
        view.set_speed(fmt_speed(sum * 1000 / el))
    }
}

// Runs all tasks on at most `parallel` threads and waits for completion.
public fun pool_run(dir: string, count: int64, parallel: int64, ref nidx: int64[], ref ~view: InstallView) {
    set_env("YUKI_POOL_DIR", dir)
    set handles: uint64[] = []
    set status: int32[] = []
    for i in 0..count {
        handles.push(0u64)
        status.push(0)
    }
    set started: int64 = 0
    set finished: int64 = 0
    set running: int64 = 0
    set t0 = now_ms()
    // No region: set_speed stores the string in a panel field and region frees it
    // right after the frame -> the next frame read the length from a dangling pointer (SIGABRT).
    loop {
        while started < count && running < parallel {
            rewrite handles[started] = spawn(cast(pool_worker, "ptr<void>"), cast(started + 1, "ptr<void>"))
            rewrite status[started] = 1
            if nidx[started] >= 0 {
                view.set_state(nidx[started], 1)
            }
            rewrite started += 1
            rewrite running += 1
        }
        for i in 0..started {
            if status[i] == 1 && is_finished(handles[i]) {
                join(handles[i])
                rewrite status[i] = 2
                rewrite running -= 1
                rewrite finished += 1
                if nidx[i] >= 0 {
                    if pool_ok(dir, i) {
                        view.set_state(nidx[i], 3)
                    } else {
                        view.set_state(nidx[i], 4)
                    }
                }
            }
        }
        pool_paint(dir, count, ref nidx, t0, ref ~view)
        view.draw(false)
        if finished >= count {
            break
        }
        sleep(40u64)
    }
}

public fun pool_ok(dir: string, i: int64) -> bool {
    set f = p_state(dir, i)
    if !file_exists(f) {
        return false
    }
    return eq(str_split(file_read_text(f), "\n")[0], "ok")
}

// Result of a successful task: second line of state-<i> ("<path>\t<bytes>").
public fun pool_out(dir: string, i: int64) -> string {
    set l = str_split(file_read_text(p_state(dir, i)), "\n")
    if l.len() < 2 {
        return ""
    }
    return str_split(l[1], "\t")[0] + ""
}

public fun pool_bytes(dir: string, i: int64) -> int64 {
    set l = str_split(file_read_text(p_state(dir, i)), "\n")
    if l.len() < 2 {
        return 0
    }
    set parts = str_split(l[1], "\t")
    if parts.len() < 2 {
        return 0
    }
    return cast(parse_int(parts[1]) ?? 0, "int64")
}

// If any task failed, raise the first error (after all of them finish).
public fun pool_raise(dir: string, count: int64, labels: string[]) {
    for i in 0..count {
        if !pool_ok(dir, i) {
            set l = str_split(file_read_text(p_state(dir, i)), "\n")
            set code: int32 = 755
            set msg = "download failed"
            if l.len() >= 3 {
                rewrite code = cast(parse_int(l[1]) ?? 755, "int32")
                rewrite msg = l[2]
            }
            panic(err(msg, code, labels[i]))
        }
    }
}
