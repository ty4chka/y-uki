// publisher.ykn — catalog publisher profiles: who stands behind a package.
// publishers.json in the index repository (optional file):
// [
//   {
//     "name": "json-yukino",          // a-z, 0-9, _ and -
//     "display": "json-yukino maintainers",
//     "summary": "the people behind the json-yukino packages",
//     "github": "json-yukino",        // GitHub account (may be empty)
//     "gitlab": "",                   // GitLab account (may be empty)
//     "homepage": "https://...",
//     "keys": ["3fa9 c07d"]           // publisher key fingerprints
//   }
// ]
// A package references a publisher via the "publisher" field in release.json; it lands
// into the index entry (write_entry) and catalog.json. Verification is strict:
// the release signer must be among the publisher's keys, then
// install/catalog/search show ✓; otherwise ✘ with advice to reconsider.

load core.panic: panic
load std.io: println
load std.json: JsonValue, json_parse
load std.strings: eq
load .errors: YukiError, err
load .catalog: verified_catalog
load .ui: info, card, c_accent, c_good, c_dim
load .theme: sym
load .util: sjoin, str_split, str_pad_end, plural, int_str

// The signed catalog as one piece (one download per command).
public fun pub_doc() -> JsonValue {
    return json_parse(verified_catalog())
}

// Publisher name of the package from the catalog ("" = field not set).
public fun pub_name_in(ref doc: JsonValue, pkg: string) -> string {
    set pk = doc.get("packages")
    for i in 0..pk.len() {
        if eq(pk.at(i).get("name").as_string_or(""), pkg) {
            return pk.at(i).get("publisher").as_string_or("")
        }
    }
    return ""
}

// Index of the publisher profile by name; -1 = not in the catalog.
// JsonValue is passed by ref: it is a class, by value it would move (not usable in a loop).
public fun pub_index(ref doc: JsonValue, name: string) -> int64 {
    set ps = doc.get("publishers")
    for i in 0..ps.len() {
        if eq(ps.at(i).get("name").as_string_or(""), name) {
            return i
        }
    }
    return -1
}

// How to show the publisher: display, and name when there is none.
public fun pub_display_in(ref doc: JsonValue, name: string) -> string {
    set pi = pub_index(ref doc, name)
    if pi >= 0 {
        set d = doc.get("publishers").at(pi).get("display").as_string_or("")
        if d.len() > 0 {
            return d
        }
    }
    return name
}

// Publisher platforms on one line: github.com/X · gitlab.com/Y · homepage
public fun pub_links_in(ref doc: JsonValue, name: string) -> string {
    set parts: string[] = []
    set pi = pub_index(ref doc, name)
    if pi >= 0 {
        set pub = doc.get("publishers").at(pi)
        set gh = pub.get("github").as_string_or("")
        set gl = pub.get("gitlab").as_string_or("")
        set hp = pub.get("homepage").as_string_or("")
        if gh.len() > 0 {
            parts.push("github.com/" + gh)
        }
        if gl.len() > 0 {
            parts.push("gitlab.com/" + gl)
        }
        if hp.len() > 0 {
            parts.push(hp)
        }
    }
    return sjoin(parts, " · ")
}

// Fingerprint without spaces: "3fa9 c07d" and "3fa9c07d" are the same.
fun norm_fp(s: string) -> string {
    return sjoin(str_split(s, " "), "")
}

// Is the release signer among the publisher's keys?
public fun pub_has_key(ref doc: JsonValue, name: string, signer: string) -> bool {
    set pi = pub_index(ref doc, name)
    if pi < 0 {
        return false
    }
    set ks = doc.get("publishers").at(pi).get("keys")
    set want = norm_fp(signer)
    for i in 0..ks.len() {
        if eq(norm_fp(ks.at(i).as_string_or("")), want) {
            return true
        }
    }
    return false
}

public fun cmd_publisher_list() {
    set doc = pub_doc()
    set ps = doc.get("publishers")
    if ps.len() == 0 {
        info("no publisher profiles in the catalog yet: maintainers add publishers.json to the index repo")
        return
    }
    set pk = doc.get("packages")
    for i in 0..ps.len() {
        set nm = ps.at(i).get("name").as_string_or("")
        set n: int64 = 0
        for k in 0..pk.len() {
            if eq(pk.at(k).get("publisher").as_string_or(""), nm) {
                rewrite n += 1
            }
        }
        println("  " + c_good(sym("ok")) + " " + c_accent(str_pad_end(nm, 16)) + c_dim(pub_links_in(ref doc, nm)) + " " + c_dim(int_str(n) + " " + plural(n, "package", "packages")))
    }
    info("details: `yuki publisher show <name>`")
}

public fun cmd_publisher_show(name: string) {
    set doc = pub_doc()
    set pi = pub_index(ref doc, name)
    if pi < 0 {
        panic(err("no such publisher in the catalog: \"" + name + "\"", 770, name))
    }
    set pub = doc.get("publishers").at(pi)
    set disp = pub.get("display").as_string_or("")
    if disp.len() == 0 {
        rewrite disp = name
    }
    set rows: string[] = []
    rows.push(c_good(sym("ok") + " " + disp) + c_dim("  publisher profile"))
    set links = pub_links_in(ref doc, name)
    if links.len() > 0 {
        rows.push("  " + c_dim("links") + "  " + links)
    }
    set sm = pub.get("summary").as_string_or("")
    if sm.len() > 0 {
        rows.push("  " + c_dim("about") + "  " + sm)
    }
    set kn = pub.get("keys").len()
    rows.push("  " + c_dim("keys") + "  " + int_str(kn) + " " + plural(kn, "key", "keys") + c_dim(" — a release counts as verified only when its signature is one of these"))
    set own: string[] = []
    set pk = doc.get("packages")
    for i in 0..pk.len() {
        if eq(pk.at(i).get("publisher").as_string_or(""), name) {
            own.push(pk.at(i).get("name").as_string_or(""))
        }
    }
    if own.len() > 0 {
        rows.push("  " + c_dim("packages") + "  " + sjoin(own, ", "))
    } else {
        rows.push("  " + c_dim("packages") + "  none yet")
    }
    card(ref rows)
    info("the ✓ mark appears where a release is checked against these keys: install, catalog, search")
}
